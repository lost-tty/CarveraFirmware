(G80: lift clear before ordinary motion resumes)
o<g80> sub
  o1 if [EXISTS[#<_drill_on>] EQ 0]
    o<g80> return
  o1 endif
  o2 if [#<_drill_on> NE 0]
    G0 Z#<_cycle_initial>
    #<_drill_on> = 0
    #<_drill_z> = 0
    #<_drill_r> = 0
    #<_drill_f> = 0
    #<_drill_q> = 0
    #<_drill_p> = 0
  o2 endif
o<g80> endsub
