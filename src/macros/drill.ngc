(G81/G82/G83 canned cycle. G98 retracts to the Z the cycle started at, G99 to the R plane, G80 cancels.)
(Z depth, R retract, F feed, Q peck, P dwell seconds stay set until the cycle ends or they are given again.)
o<drill> sub
  o1 if [EXISTS[#<z>]]
    #<_drill_z> = #<z>
  o1 endif
  o13 if [EXISTS[#<_drill_z>] EQ 0]
    o<drill> abort [17]
  o13 endif
  o2 if [EXISTS[#<r>]]
    #<_drill_r> = #<r>
  o2 endif
  o14 if [EXISTS[#<_drill_r>] EQ 0]
    o<drill> abort [17]
  o14 endif
  o3 if [EXISTS[#<f>]]
    #<_drill_f> = #<f>
  o3 endif
  o4 if [[#<code> EQ 83] AND EXISTS[#<q>]]
    #<_drill_q> = #<q>
  o4 endif
  o5 if [[#<code> EQ 82] AND EXISTS[#<p>]]
    #<_drill_p> = #<p>
  o5 endif
  o6 if [EXISTS[#<_drill_f>] EQ 0]
    o<drill> abort [17]
  o6 endif
  o16 if [#<_drill_f> LE 0]
    o<drill> abort [17]
  o16 endif

  #<_drill_on> = 1
  #<to_r> = 0
  o8 if [EXISTS[#<_drill_to_r>]]
    #<to_r> = #<_drill_to_r>
  o8 endif
  #<initial> = #<_cycle_initial>
  o17 if [#<to_r> NE 0]
    #<_drill_plane> = #<_drill_r>
  o17 else
    #<_drill_plane> = #<initial>
  o17 endif

  G0 Z#<initial>
  o9 if [EXISTS[#<x>] AND EXISTS[#<y>]]
    G0 X#<x> Y#<y>
  o9 elseif [EXISTS[#<x>]]
    G0 X#<x>
  o9 elseif [EXISTS[#<y>]]
    G0 Y#<y>
  o9 endif
  G0 Z#<_drill_r>

  #<peck> = 0
  o18 if [[#<code> EQ 83] AND EXISTS[#<_drill_q>]]
    #<peck> = #<_drill_q>
  o18 endif
  o10 if [#<peck> GT 0]
    #<zz> = #<_drill_r>
    o11 while [[#<zz> - #<peck>] GT #<_drill_z>]
      #<zz> = [#<zz> - #<peck>]
      G1 Z#<zz> F#<_drill_f>
      G0 Z#<_drill_r>
    o11 endwhile
    G1 Z#<_drill_z> F#<_drill_f>
  o10 else
    G1 Z#<_drill_z> F#<_drill_f>
  o10 endif

  #<dwell> = 0
  o19 if [[#<code> EQ 82] AND EXISTS[#<_drill_p>]]
    #<dwell> = #<_drill_p>
  o19 endif
  o12 if [#<dwell> GT 0]
    G4 P#<dwell>
  o12 endif
  G0 Z#<_drill_plane>
o<drill> endsub
