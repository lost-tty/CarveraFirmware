(One hole of cycle #1, 81 to 83, from the words G81..G83 keep in #<_drill_*>.)
(Z depth, R retract, F feed, Q peck, P dwell seconds stay set until the cycle ends or are given again.)
(X and Y move as #<_drill_xy> says: 1 X, 2 Y, 3 both.)
o<drill> sub
  #<mode> = #<_motion_mode>
  o13 if [EXISTS[#<_drill_z>] EQ 0]
    o<drill> abort [17]
  o13 endif
  o14 if [EXISTS[#<_drill_r>] EQ 0]
    o<drill> abort [17]
  o14 endif
  o6 if [EXISTS[#<_drill_f>] EQ 0]
    o<drill> abort [17]
  o6 endif
  o16 if [#<_drill_f> LE 0]
    o<drill> abort [17]
  o16 endif

  #<_drill_on> = 1
  #<to_r> = 0
  o8 if [EXISTS[#<_drill_to_r>]]
    #<to_r> = #<_drill_to_r>
  o8 endif
  #<initial> = #<_cycle_initial>
  o17 if [#<to_r> NE 0]
    #<_drill_plane> = #<_drill_r>
  o17 else
    #<_drill_plane> = #<initial>
  o17 endif

  G0 Z#<initial>
  o9 if [#<_drill_xy> EQ 3]
    G0 X#<_drill_x> Y#<_drill_y>
  o9 elseif [#<_drill_xy> EQ 1]
    G0 X#<_drill_x>
  o9 elseif [#<_drill_xy> EQ 2]
    G0 Y#<_drill_y>
  o9 endif
  G0 Z#<_drill_r>

  #<peck> = 0
  o18 if [[#1 EQ 83] AND EXISTS[#<_drill_q>]]
    #<peck> = #<_drill_q>
  o18 endif
  o10 if [#<peck> GT 0]
    #<zz> = #<_drill_r>
    o11 while [[#<zz> - #<peck>] GT #<_drill_z>]
      #<zz> = [#<zz> - #<peck>]
      G1 Z#<zz> F#<_drill_f>
      G0 Z#<_drill_r>
    o11 endwhile
    G1 Z#<_drill_z> F#<_drill_f>
  o10 else
    G1 Z#<_drill_z> F#<_drill_f>
  o10 endif

  #<dwell> = 0
  o19 if [[#1 EQ 82] AND EXISTS[#<_drill_p>]]
    #<dwell> = #<_drill_p>
  o19 endif
  o12 if [#<dwell> GT 0]
    G4 P#<dwell>
  o12 endif
  G0 Z#<_drill_plane>
  #<_motion_mode> = #<mode>
o<drill> endsub
