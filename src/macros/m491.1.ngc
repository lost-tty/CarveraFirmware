(M491.1 H<tol> measures the tool and checks it against the stored length)
o<m491.1> sub
  #<sx> = #5021
  #<sy> = #5022
  #<old> = #<_tlo>
  #<tol> = 0.1
  o1 if [EXISTS[#<h>]]
    #<tol> = #<h>
  o1 endif
  o2 if [#<tol> LT 0.02]
    o<m491.1> abort [4]
  o2 endif
  o<calibrate_at> call [#<_clearance_z>] [#<_active_tool> EQ 0]
  o3 if [#<old> NE 0]
    M5
    G53 G0 Z#<_atc_safe_z>
    o4 if [ABS[#<_tlo> - #<old>] GT #<tol>]
      o<m491.1> abort [4]
    o4 endif
  o3 endif
  G53 G0 Z#<_clearance_z>
  G53 G0 X#<sx> Y#<sy>
o<m491.1> endsub
